<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DraCode.KoboldLair\DraCode.KoboldLair.csproj" />
    <ProjectReference Include="..\DraCode.ServiceDefaults\DraCode.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.AspNetCore.Authentication.JwtBearer — JWT Bearer auth is NOT in the ASP.NET shared
         framework, and it is required by the source-compiled Birko.Security.AspNetCore
         (AddBirkoJwtBearer). That is still true; what changed is who declares it. This project imports
         Birko.Security.AspNetCore.projitems below, and the .projitems now declares the package itself,
         injecting its PackageReference here — so declaring it again is NU1504. Our exact 10.0.0 also
         froze what the framework deliberately floats as 10.*, which loses the advisory self-healing
         that float exists for. -->

    <!-- /api/v1 REST facade (TASK-042): built-in OpenAPI doc generation + Scalar self-hosted docs UI
         (no external CDN). MapOpenApi serves JSON only; Scalar provides the UI. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.1.18" />
  </ItemGroup>

  <!-- The Birko framework (models, stores, SQL chain, security, OAuth server) is source-compiled in
       DraCode.Birko and reaches here transitively via DraCode.KoboldLair. Do NOT re-import those
       projitems — single compiled identity is the whole point (see DraCode.Birko.csproj).
       Only ASP.NET-coupled projitems that define no shared identity types live here. -->
  <!-- Birko.Data.Tenant carries ASP.NET middleware (TenantMiddleware) and is required by
       Birko.Security.AspNetCore (TenantContextAdapter). Nothing in DraCode.Birko references it, so it
       compiles here in the web host rather than the plain-SDK aggregator. -->
  <Import Project="$(BirkoSrc)\Birko.Data.Tenant\Birko.Data.Tenant.projitems" Label="Shared" />
  <Import Project="$(BirkoSrc)\Birko.Security.AspNetCore\Birko.Security.AspNetCore.projitems" Label="Shared" />
  <Import Project="$(BirkoSrc)\Birko.Communication.WebSocket\Birko.Communication.WebSocket.projitems" Label="Shared" />
  <Import Project="$(BirkoSrc)\Birko.Communication.SSE\Birko.Communication.SSE.projitems" Label="Shared" />
  <Import Project="$(BirkoSrc)\Birko.Communication\Birko.Communication.projitems" Label="Shared" />
  <Import Project="$(BirkoSrc)\Birko.BackgroundJobs\Birko.BackgroundJobs.projitems" Label="Shared" />
  <Import Project="$(BirkoSrc)\Birko.MessageQueue.InMemory\Birko.MessageQueue.InMemory.projitems" Label="Shared" />

</Project>
