{
  "// INSTRUCTIONS": "Copy this file to appsettings.local.json and configure your providers",
  "// GitHub federation (TASK-033)": "Set Enabled=true, register a GitHub OAuth app, and export KOBOLDLAIR_GITHUB_CLIENT_ID / KOBOLDLAIR_GITHUB_CLIENT_SECRET. AllowedGitHubIds is a DENY-ALL allowlist of GitHub numeric user ids — add your own id or no one can log in. Requires Authentication:Jwt:Enabled=true.",
  "Authentication": {
    "GitHub": {
      "Enabled": false,
      "ClientId": "${KOBOLDLAIR_GITHUB_CLIENT_ID}",
      "ClientSecret": "${KOBOLDLAIR_GITHUB_CLIENT_SECRET}",
      "RedirectUri": "https://localhost:57085/auth/github/callback",
      "Scope": "read:user",
      "DefaultRoles": [ "user" ],
      "AllowedGitHubIds": [ 123456 ],
      "PostLoginRedirectUri": "https://localhost:57085/"
    }
  },
  "KoboldLair": {
    "DefaultProvider": "your-default-provider-name",
    "Providers": [
      {
        "Name": "openai",
        "DisplayName": "OpenAI GPT-4",
        "Type": "openai",
        "DefaultModel": "gpt-4o",
        "CompatibleAgents": [
          "dragon",
          "wyvern",
          "wyrm",
          "kobold"
        ],
        "IsEnabled": true,
        "RequiresApiKey": true,
        "Description": "OpenAI GPT-4 API",
        "Configuration": {
          "baseUrl": "https://api.openai.com/v1/chat/completions"
        }
      },
      {
        "Name": "claude",
        "DisplayName": "Claude 3",
        "Type": "claude",
        "DefaultModel": "claude-3-haiku-20240307",
        "CompatibleAgents": [
          "dragon",
          "wyvern",
          "wyrm",
          "kobold"
        ],
        "IsEnabled": false,
        "RequiresApiKey": true,
        "Description": "Anthropic Claude API",
        "Configuration": {
          "baseUrl": "https://api.anthropic.com/v1/messages"
        }
      },
      {
        "Name": "ollama",
        "DisplayName": "Ollama (Local)",
        "Type": "ollama",
        "DefaultModel": "llama3",
        "CompatibleAgents": [
          "dragon",
          "wyvern",
          "wyrm",
          "kobold"
        ],
        "IsEnabled": false,
        "RequiresApiKey": false,
        "Description": "Local Ollama server",
        "Configuration": {
          "baseUrl": "http://localhost:11434"
        }
      },
      {
        "Name": "llamacpp",
        "DisplayName": "Llama.cpp (Local)",
        "Type": "llamacpp",
        "DefaultModel": "default",
        "CompatibleAgents": [
          "dragon",
          "wyvern",
          "wyrm",
          "kobold"
        ],
        "IsEnabled": false,
        "RequiresApiKey": false,
        "Description": "Local llama.cpp server",
        "Configuration": {
          "baseUrl": "http://localhost:8080"
        }
      },
      {
        "Name": "githubcopilot",
        "DisplayName": "GitHub Copilot",
        "Type": "githubcopilot",
        "DefaultModel": "gpt-4o",
        "CompatibleAgents": [
          "dragon",
          "wyvern",
          "wyrm",
          "kobold"
        ],
        "IsEnabled": false,
        "RequiresApiKey": true,
        "Description": "GitHub Copilot API",
        "Configuration": {
          "clientId": "clientid",
          "baseUrl": "https://api.githubcopilot.com/chat/completions"
        }
      }
    ]
  }
}