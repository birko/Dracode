<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DraCode.ServiceDefaults\DraCode.ServiceDefaults.csproj" />
  </ItemGroup>

  <!-- TypeScript Build Integration -->
  <Target Name="NpmInstall" BeforeTargets="Build" Condition="!Exists('node_modules')">
    <Exec Command="npm install" WorkingDirectory="$(ProjectDir)" />
  </Target>

  <!-- TypeScript compilation -->
  <Target Name="TypeScriptCompile" BeforeTargets="Build" DependsOnTargets="NpmInstall" Condition="'$(SkipTypeScriptCompile)' != 'true'">
    <Exec Command="node build.js" WorkingDirectory="$(ProjectDir)" ContinueOnError="false" StdOutEncoding="utf-8" StdErrEncoding="utf-8" />
  </Target>

  <!-- Watch mode for development -->
  <Target Name="WatchTypeScript" AfterTargets="Build" Condition="'$(WatchTypeScript)' == 'true'">
    <Exec Command="npm run watch" WorkingDirectory="$(ProjectDir)" />
  </Target>

</Project>
